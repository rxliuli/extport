{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "extport",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // One Worker serves both the API (/api/*, run_worker_first below) and the
  // dashboard SPA (everything else, from the built assets with SPA fallback
  // for TanStack Router's client-side routes). Same-origin by construction —
  // no CORS, no cross-site cookies, and dev (vite proxying /api to wrangler)
  // matches production shape exactly.
  "assets": {
    "directory": "../dashboard/dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // Every request goes through the Worker so it can enforce host-based
    // routing (api.* is API-only, portal.* is portal-only) before handing
    // non-API paths to the assets binding.
    "run_worker_first": true
  },
  // dash.* on purpose — the apex stays reserved for a future marketing site.
  // Requires the extport.dev zone to exist on this Cloudflare account before
  // the first deploy.
  // api.* is the public licensing surface (@extport/sdk's default apiBase).
  // Same Worker — a separate hostname only because that default gets baked
  // into installed extension binaries, and a UI hostname must never be the
  // least-changeable contract in the system. See docs/licensing.md.
  // portal.* is the buyer-facing surface (checkout success page + purchase
  // portal) — like api.*, its URLs get baked into long-lived external
  // config (Payment Link redirects, magic-link emails).
  "routes": [
    { "pattern": "dash.extport.dev", "custom_domain": true },
    { "pattern": "api.extport.dev", "custom_domain": true },
    { "pattern": "portal.extport.dev", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "extport",
      "database_id": "86961734-96e0-4e8e-ba2d-48423b94ff46",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "extport-artifacts"
    }
  ],
  "triggers": {
    // Reconciliation loop (spec §3.1) — every 30 minutes; nightly analytics
    // rollup at 00:15 UTC (the expression is matched verbatim in index.ts).
    "crons": ["*/30 * * * *", "15 0 * * *"]
  },
  "send_email": [
    {
      "name": "EMAIL"
      // Local dev sends are logged, not delivered, unless you add "remote": true
      // and onboard a domain: `wrangler email sending enable yourdomain.com`.
    }
  ],
  "vars": {
    // Non-secret config, production values. Local dev overrides live in
    // .dev.vars (which also holds the secrets KEK_V1 / GITHUB_CLIENT_SECRET;
    // production secrets are set once via `wrangler secret put`).
    "CURRENT_KEK_VERSION": "1",
    "DASHBOARD_URL": "https://dash.extport.dev",
    "PORTAL_URL": "https://portal.extport.dev",
    // The production GitHub OAuth App's client id (public, fine to commit) —
    // callback URL must be https://dash.extport.dev/api/auth/github/callback.
    "GITHUB_CLIENT_ID": "Ov23lidxVa6vp0AA8Mpf",
    // Must be on a domain onboarded via `wrangler email sending enable`.
    "NOTIFICATION_FROM_EMAIL": "notifications@extport.dev"
  }
}
