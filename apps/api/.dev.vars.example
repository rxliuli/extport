# Copy to .dev.vars (gitignored) for local development.
# Generate a KEK with: openssl rand -base64 32
KEK_V1=""
GITHUB_CLIENT_SECRET=""
# Local override — production value in wrangler.jsonc points at dash.extport.dev.
DASHBOARD_URL=http://localhost:5173

# GET /api/auth/dev-login — mints a session directly, skipping the GitHub
# OAuth round trip (which needs a matching registered callback URL). Optional;
# only uncomment for local testing. Never set outside .dev.vars.
# DEV_LOGIN_ENABLED=true

# Enables the temporary /auth/dev-login route (local development only).
DEV_LOGIN_ENABLED=false

# Reads Analytics Engine for the nightly rollup (the ANALYTICS binding is
# write-only). Create at Cloudflare → My Profile → API Tokens → Custom token
# with a single permission: Account → Account Analytics → Read. Only needed to
# run the rollup locally; leaving it empty just skips that cron.
ANALYTICS_API_TOKEN=""
