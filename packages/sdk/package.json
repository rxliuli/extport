{
  "name": "@extport/sdk",
  "version": "0.0.4",
  "description": "License activation client for browser extensions publishing through extport",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rxliuli/extport.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./webext": {
      "types": "./dist/webext.d.mts",
      "import": "./dist/webext.mjs"
    },
    "./react": {
      "types": "./dist/react.d.mts",
      "import": "./dist/react.mjs"
    },
    "./analytics": {
      "types": "./dist/analytics.d.mts",
      "import": "./dist/analytics.mjs"
    },
    "./wxt-analytics": {
      "types": "./dist/wxt-analytics.d.mts",
      "import": "./dist/wxt-analytics.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "fake-indexeddb": "^6.2.5",
    "react": "^19.2.7",
    "tsdown": "^0.22.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
