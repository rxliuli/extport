{
  "name": "extport",
  "private": true,
  "version": "0.0.0",
  "description": "Browser extension publishing & licensing platform",
  "scripts": {
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @extport/dashboard test:e2e",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "packageManager": "pnpm@12.18.0",
  "devDependencies": {
    "oxfmt": "0.78.0",
    "typescript": "^7.0.2"
  }
}
